<?xml version="1.0" encoding="utf-8"?>
<!--
  The collapsed notification: red stripe down the left edge (as on the app's cards), a heavy italic
  title and a grey line under it, and the big red percentage on the right. Only view classes that
  RemoteViews allows are used (so a FrameLayout, not a plain View, for the stripe).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/notif_stripe"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="@color/p5_red" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/p5_white"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/notif_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/p5_grey"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/notif_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:adjustViewBounds="true"
        android:maxHeight="44dp"
        android:scaleType="fitCenter" />
</LinearLayout>
