<?xml version="1.0" encoding="utf-8"?>
<!--
  The expanded notification: the same stripe, title and percentage, with the whole text (video name
  and step) and the slanted red progress bar underneath (drawn by NotificationArt.progressBar).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_bg"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/notif_stripe"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:background="@color/p5_red" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notif_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/p5_white"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/notif_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="4"
                    android:textColor="@color/p5_grey"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/notif_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:adjustViewBounds="true"
                android:maxHeight="44dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <ImageView
            android:id="@+id/notif_bar"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:scaleType="fitXY" />
    </LinearLayout>
</LinearLayout>
